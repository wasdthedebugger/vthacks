# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ---------------------------------------------------------------- database
# MySQL 8. The app creates its own prefixed tables and touches nothing else in
# the schema, so it can share a database with another application.
PERSIST_HEALTH_DB_HOST=
PERSIST_HEALTH_DB_PORT=3306
PERSIST_HEALTH_DB_USER=
PERSIST_HEALTH_DB_PASSWORD=
PERSIST_HEALTH_DB_NAME=
PERSIST_HEALTH_TABLE_PREFIX=mb_

# ---------------------------------------------------------------- ai
# Any OpenAI-compatible chat-completions endpoint.
PERSIST_HEALTH_API_KEY=
PERSIST_HEALTH_BASE_URL=https://openrouter.ai/api/v1
PERSIST_HEALTH_MODEL=

# Tried in order if the primary model fails (rate limits, outages). Comma
# separated. Falls through to the offline analysis pass if all of them fail.
PERSIST_HEALTH_FALLBACK_MODELS=

# Per-attempt cap, in ms, before moving on to the next model in the chain.
PERSIST_HEALTH_MODEL_TIMEOUT_MS=90000

# ---------------------------------------------------------------- auth
PERSIST_HEALTH_DOCTOR_PASSWORD=persisthealth
